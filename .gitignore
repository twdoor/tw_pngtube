# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
.import/
export.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Keep maintained regressions and benchmarks; ignore local artwork and experiments.
testing/*
!testing/README.md
!testing/run_tests.gd
!testing/run_tests.gd.uid
!testing/test_*.gd
!testing/test_*.gd.uid
!testing/benchmark_*.gd
!testing/benchmark_*.gd.uid

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Reproducible release configuration is tracked; generated artifacts are not.
/builds/
/dist/
